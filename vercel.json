{
  "version": 2,
  "functions": {
    "api/card.js": {
      "includeFiles": "node_modules/@resvg/resvg-wasm/**"
    },
    "api/social.js": {
      "maxDuration": 60
    },
    "api/insights.js": {
      "maxDuration": 60
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(study|verse|lights)/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/i18n/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/warm",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/social?action=due",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/journal/:slug",
      "destination": "/api/journal-page?slug=:slug"
    },
    {
      "source": "/pinterest/callback",
      "destination": "/api/social?action=pin-callback"
    },
    {
      "source": "/youtube/callback",
      "destination": "/api/youtube?action=callback"
    },
    {
      "source": "/threads/callback",
      "destination": "/api/threads?action=callback"
    }
  ]
}
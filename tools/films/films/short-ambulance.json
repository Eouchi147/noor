          "lines": [
            {
              "text": "One old van became a giant rescue fleet",
              "sub": "the largest volunteer fleet on earth",
              "size": "hook",
              "at": 0.0,
              "until": 6.63
            },
            {
              "text": "Karachi, Pakistan, 1951",
              "sub": "Abdul Sattar Edhi, a poor cloth seller",
              "size": "h1",
              "at": 6.97,
              "until": 12.46
            },
            {
              "text": "He opens a tiny free clinic",
              "size": "h1",
              "at": 12.8,
              "until": 15.76
            },
            {
              "text": "A donation buys one battered van",
              "sub": "Edhi drives it himself to every disaster",
              "size": "h1",
              "at": 16.1,
              "until": 22.48
            },
            {
              "text": "From that van grows a whole fleet",
              "size": "h1",
              "at": 22.82,
              "until": 26.23
            },
            {
              "text": "Outside each centre he puts a cradle",
              "sub": "so no unwanted baby is ever killed",
              "size": "h1",
              "at": 26.57,
              "until": 32.86
            },
            {
              "text": "Critics asked why he carried non Muslims",
              "sub": "the ambulance is more Muslim than you",
              "size": "h1",
              "at": 33.2,
              "until": 39.96
            },
            {
              "text": "His ambulances still ask no one's faith",
              "size": "h1",
              "at": 40.3,
              "until": 44.11
            },
            {
              "eyebrow": "Abdul Sattar Edhi, Karachi",
              "text": "He owned two sets of clothes",

          "hold": 49.0,
          "lines": [
            {
              "text": "A camera once caught a bond breaking",
              "sub": "the bond between two atoms lets go",
              "size": "hook",
              "at": 0.0,
              "until": 6.29
            },
            {
              "text": "Egypt, then California, the 1980s",
              "sub": "a chemist named Ahmed Zewail, 1946 to 2016",
              "size": "h1",
              "at": 6.63,
              "until": 13.21
            },
            {
              "text": "Two atoms start out joined by a bond",
              "size": "h1",
              "at": 13.55,
              "until": 17.21
            },
            {
              "text": "The middle frame catches the moment itself",
              "sub": "the instant the bond actually snaps",
              "size": "h1",
              "at": 17.55,
              "until": 24.26
            },
            {
              "text": "Then the same two atoms sit apart",
              "size": "h1",
              "at": 24.6,
              "until": 28.01
            },
            {
              "text": "The flash is briefer than the change",
              "size": "h1",
              "at": 28.35,
              "until": 31.96
            },
            {
              "text": "Chemists once could not see the during",
              "sub": "only ever the before and the after",
              "size": "h1",
              "at": 32.3,
              "until": 38.73
            },
            {
              "text": "Chemistry still has its own slow motion",
              "size": "h1",
              "at": 39.07,
              "until": 42.88
            },
            {
              "eyebrow": "Ahmed Zewail, Caltech",
              "text": "He founded femtochemistry, filming atoms",
              "src": "Nobel Prize in Chemistry, 1999",
              "size": "h1",
              "at": 43.22,
              "until": 48.61
            }

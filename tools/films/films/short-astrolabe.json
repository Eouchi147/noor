          "lines": [
            {
              "text": "An astrolabe is the sky folded in brass",
              "sub": "the working computer of a thousand years",
              "size": "hook",
              "at": 0.0,
              "until": 6.94
            },
            {
              "text": "A catalogue in Baghdad, about 987",
              "sub": "it names al-Ijliya, who made them, in Aleppo",
              "size": "h1",
              "at": 7.28,
              "until": 14.04
            },
            {
              "text": "Sight a star along the sighting bar",
              "size": "h1",
              "at": 14.38,
              "until": 17.92
            },
            {
              "text": "Read its height on the graduated rim",
              "size": "h1",
              "at": 18.26,
              "until": 21.87
            },
            {
              "text": "Turn the star map to match the sky",
              "size": "h1",
              "at": 22.21,
              "until": 25.74
            },
            {
              "text": "Now read the hour and the prayer times",
              "size": "h1",
              "at": 26.08,
              "until": 29.87
            },
            {
              "text": "Greek geometry first drew the disc",
              "sub": "Muslim makers added plates for latitudes",
              "size": "h1",
              "at": 30.21,
              "until": 36.67
            },
            {
              "text": "Your star map app is an astrolabe reborn",
              "size": "h1",
              "at": 37.01,
              "until": 40.94
            },
            {
              "eyebrow": "Al-Ijliya, Aleppo",
              "text": "All we securely know of her fits one line",
              "src": "The Fihrist, about 987",
              "size": "h1",
              "at": 41.28,
              "until": 46.62

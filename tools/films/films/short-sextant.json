          "kind": "plate",
          "plate": "sextant",
          "hold": 45.3,
          "lines": [
            {
              "text": "A king measured the sky in stone",
              "size": "hook",
              "at": 0.0,
              "until": 3.56
            },
            {
              "text": "Samarkand, in Uzbekistan, the 1420s",
              "sub": "the king is Ulugh Beg, an astronomer",
              "size": "h1",
              "at": 3.9,
              "until": 10.16
            },
            {
              "text": "He sank an arc into the bedrock",
              "sub": "about forty metres across",
              "size": "h1",
              "at": 10.5,
              "until": 15.71
            },
            {
              "text": "Bigger means finer",
              "sub": "a minute of sky is a centimetre of stone",
              "size": "h1",
              "at": 16.05,
              "until": 21.44
            },
            {
              "text": "He paid a salaried staff",
              "sub": "and scholars came from many lands",
              "size": "h1",
              "at": 21.78,
              "until": 27.06
            },
            {
              "text": "They fixed a thousand stars",
              "sub": "the first fresh catalogue in 1,000 years",
              "size": "h1",
              "at": 27.4,
              "until": 33.39
            },
            {
              "text": "He was killed, the tower pulled down",
              "sub": "the numbers got to Oxford anyway",
              "size": "h1",
              "at": 33.73,
              "until": 39.84
            },
            {
              "eyebrow": "Ulugh Beg, Samarkand",
              "text": "Instruments break. Numbers travel",
              "src": "Printed at Oxford, 1665",
              "size": "h1",
              "at": 40.18,

          "hold": 47.8,
          "lines": [
            {
              "text": "A king measured the sky with a stone arc",
              "size": "hook",
              "at": 0.0,
              "until": 3.98
            },
            {
              "text": "Samarkand, in Uzbekistan, the 1420s",
              "sub": "Ulugh Beg, a king and astronomer, rules",
              "size": "h1",
              "at": 4.32,
              "until": 10.78
            },
            {
              "text": "He sank an arc into the bedrock",
              "sub": "about forty metres across",
              "size": "h1",
              "at": 11.12,
              "until": 16.33
            },
            {
              "text": "A bigger instrument reads a finer sky",
              "sub": "a minute of sky is a centimetre of stone",
              "size": "h1",
              "at": 16.67,
              "until": 23.53
            },
            {
              "text": "His team measures the year's length",
              "sub": "to within about one minute",
              "size": "h1",
              "at": 23.87,
              "until": 29.41
            },
            {
              "text": "They fix a thousand stars",
              "sub": "the first fresh catalogue in 1,000 years",
              "size": "h1",
              "at": 29.75,
              "until": 35.61
            },
            {
              "text": "He was killed, the tower pulled down",
              "sub": "but the numbers still reached Oxford",
              "size": "h1",
              "at": 35.95,
              "until": 42.33
            },
            {
              "eyebrow": "Ulugh Beg, Samarkand",
              "text": "Instruments break. Numbers travel",
              "src": "Printed at Oxford, 1665",
              "size": "h1",
              "at": 42.67,

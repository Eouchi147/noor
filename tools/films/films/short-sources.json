          "hold": 48.3,
          "lines": [
            {
              "text": "Every Islamic ruling follows four steps",
              "sub": "always in the same fixed order",
              "size": "hook",
              "at": 0.0,
              "until": 6.13
            },
            {
              "text": "Cairo, Egypt, around the year 814",
              "sub": "a jurist named Ash-Shafi'i arrives",
              "size": "h1",
              "at": 6.47,
              "until": 12.41
            },
            {
              "text": "First, what does the Qur'an itself say",
              "size": "h1",
              "at": 12.75,
              "until": 16.49
            },
            {
              "text": "Then the Sunnah, the Prophet's practice",
              "size": "h1",
              "at": 16.83,
              "until": 20.59
            },
            {
              "text": "Then ijma, what the scholars agreed",
              "size": "h1",
              "at": 20.93,
              "until": 24.42
            },
            {
              "text": "Then qiyas, likeness to a case settled",
              "size": "h1",
              "at": 24.76,
              "until": 28.5
            },
            {
              "text": "Before him, jurists just disagreed",
              "sub": "after him, they disagreed by shared rules",
              "size": "h1",
              "at": 28.84,
              "until": 35.37
            },
            {
              "text": "Every school of law still uses his four",
              "sub": "Qur'an, Sunnah, agreement, then likeness",
              "size": "h1",
              "at": 35.71,
              "until": 42.55
            },
            {
              "eyebrow": "Ash-Shafi'i, Cairo",
              "text": "He wrote the grammar for the argument",
              "src": "Ar-Risala, principles of law, 767 to 820",
              "size": "h1",
              "at": 42.89,
              "until": 47.93
            }

      "id": "the-short",
      "title": "One gift, still paying",
      "theme": "nutvoid",
      "short": true,
      "beats": [
        {
          "kind": "plate",
          "plate": "one-endowment-made-in-859-still-paying",
          "hold": 49.5,
          "lines": [
            {
              "text": "One gift never stopped paying out",
              "sub": "founded in 859, still teaching today",
              "size": "hook",
              "at": 0.0,
              "until": 6.13
            },
            {
              "text": "Fez, Morocco, in the year 859",
              "sub": "a founder, Fatima al-Fihri, gives her wealth",
              "size": "h1",
              "at": 6.47,
              "until": 12.91
            },
            {
              "text": "She endows a mosque with her inheritance",
              "size": "h1",
              "at": 13.25,
              "until": 17.13
            },
            {
              "text": "Dynasties rise, then fall, again and again",
              "size": "h1",
              "at": 17.47,
              "until": 21.48
            },
            {
              "text": "Beneath them, one line runs unbroken",
              "sub": "the school itself just keeps teaching",
              "size": "h1",
              "at": 21.82,
              "until": 28.21
            },
            {
              "text": "It is called waqf, an endowment forever",
              "size": "h1",
              "at": 28.55,
              "until": 32.36
            },
            {
              "text": "Her own story thinned. The school did not",
              "sub": "recognized as the oldest still teaching",
              "size": "h1",
              "at": 32.7,
              "until": 39.66
            },
            {
              "text": "Her gift still outlives every dynasty",
              "size": "h1",
              "at": 40.0,
              "until": 43.63
            },
            {
              "eyebrow": "Fatima al-Fihri, Fez",
              "text": "She endowed it, and it never stopped",
              "src": "Al-Qarawiyyin, founded 859, still teaching",
              "size": "h1",
              "at": 43.97,
              "until": 49.13
            }

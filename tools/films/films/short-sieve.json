            {
              "text": "One book was checked 600,000 times",
              "size": "hook",
              "at": 0.0,
              "until": 3.56
            },
            {
              "text": "Bukhara, in Uzbekistan, the year 846",
              "sub": "a scholar, Muhammad al-Bukhari",
              "size": "h1",
              "at": 3.9,
              "until": 9.73
            },
            {
              "text": "He gathers everything people report",
              "sub": "from over a thousand teachers",
              "size": "h1",
              "at": 10.07,
              "until": 15.76
            },
            {
              "text": "Then he tests every single one",
              "size": "h1",
              "at": 16.1,
              "until": 19.26
            },
            {
              "text": "Did these two men really meet?",
              "sub": "how good was his memory, and his character",
              "size": "h1",
              "at": 19.6,
              "until": 26.03
            },
            {
              "text": "He threw out a man he saw",
              "sub": "tricking his horse with an empty bag",
              "size": "h1",
              "at": 26.37,
              "until": 32.06
            },
            {
              "text": "Out of 600,000 reports",
              "sub": "about 2,600 came through",
              "size": "h1",
              "at": 32.4,
              "until": 36.79
            },
            {
              "text": "Doubt, made a method",
              "size": "h1",
              "at": 37.13,
              "until": 39.52
            },
            {
              "eyebrow": "Muhammad al-Bukhari",
              "text": "He died poor, in exile, in 870",

          "lines": [
            {
              "text": "One man tested 600,000 hadith reports",
              "size": "hook",
              "at": 0.0,
              "until": 3.63
            },
            {
              "text": "Bukhara, in Uzbekistan, the 800s",
              "sub": "a scholar, Muhammad al-Bukhari",
              "size": "h1",
              "at": 3.97,
              "until": 9.48
            },
            {
              "text": "He gathers everything people report",
              "sub": "from over a thousand teachers",
              "size": "h1",
              "at": 9.82,
              "until": 15.51
            },
            {
              "text": "Then he tests every single one",
              "size": "h1",
              "at": 15.85,
              "until": 19.01
            },
            {
              "text": "Did these two men really meet?",
              "sub": "how good was his memory and character",
              "size": "h1",
              "at": 19.35,
              "until": 25.39
            },
            {
              "text": "He drops one man for a small lie",
              "sub": "the man tricked his horse with an empty bag",
              "size": "h1",
              "at": 25.73,
              "until": 32.51
            },
            {
              "text": "Out of 600,000 reports",
              "sub": "about 2,600 come through",
              "size": "h1",
              "at": 32.85,
              "until": 37.24
            },
            {
              "text": "Every hadith you read passed his test",
              "size": "h1",
              "at": 37.58,
              "until": 41.26
            },
            {
              "eyebrow": "Muhammad al-Bukhari",
              "text": "He died poor, in exile, in 870",
              "src": "Sahih al-Bukhari, counts by the tradition",
              "size": "h1",
              "at": 41.6,
              "until": 46.24
            }

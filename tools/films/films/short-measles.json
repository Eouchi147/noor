      "beats": [
        {
          "kind": "plate",
          "plate": "one-patient-with-fever-and-a-rash-and",
          "hold": 48.8,
          "lines": [
            {
              "text": "One doctor first told two fevers apart",
              "sub": "smallpox and measles, both fever and rash",
              "size": "hook",
              "at": 0.0,
              "until": 6.89
            },
            {
              "text": "Rayy and Baghdad, about the year 900",
              "sub": "a physician named Abu Bakr al-Razi",
              "size": "h1",
              "at": 7.23,
              "until": 13.47
            },
            {
              "text": "One fever and rash look like one disease",
              "size": "h1",
              "at": 13.81,
              "until": 17.74
            },
            {
              "text": "He sorts them into two: smallpox",
              "size": "h1",
              "at": 18.08,
              "until": 21.37
            },
            {
              "text": "Measles sits on the other side",
              "size": "h1",
              "at": 21.71,
              "until": 24.87
            },
            {
              "text": "The same questions get asked of each",
              "sub": "fever pattern, rash type, timing",
              "size": "h1",
              "at": 25.21,
              "until": 31.27
            },
            {
              "text": "He judges by evidence, not by habit",
              "sub": "and he writes the answer down each time",
              "size": "h1",
              "at": 31.61,
              "until": 38.22
            },
            {
              "text": "Every diagnosis today follows that split",
              "size": "h1",
              "at": 38.56,
              "until": 42.39
            },
            {
              "eyebrow": "Abu Bakr al-Razi, Baghdad",
              "text": "Diagnosis by evidence: still his method",
              "src": "On Smallpox and Measles, about 865 to 925",
              "size": "h1",
              "at": 42.73,
              "until": 48.42
            }

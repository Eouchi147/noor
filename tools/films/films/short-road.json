          "lines": [
            {
              "text": "Your science passed through Arabic first",
              "sub": "even math and medicine came this way",
              "size": "hook",
              "at": 0.0,
              "until": 6.64
            },
            {
              "text": "Baghdad, Iraq, the 800s",
              "sub": "Hunayn ibn Ishaq, a translator",
              "size": "h1",
              "at": 6.98,
              "until": 11.89
            },
            {
              "text": "He hunts down rare Greek manuscripts",
              "size": "h1",
              "at": 12.23,
              "until": 15.79
            },
            {
              "text": "He translates meaning, not each word",
              "size": "h1",
              "at": 16.13,
              "until": 19.69
            },
            {
              "text": "Toledo then translates his Arabic work",
              "sub": "into Latin, the 1100s",
              "size": "h1",
              "at": 20.03,
              "until": 25.39
            },
            {
              "text": "Then Europe teaches from his translation",
              "sub": "corrections and commentaries included",
              "size": "h1",
              "at": 25.73,
              "until": 32.29
            },
            {
              "text": "This was correction, not mere copying",
              "size": "h1",
              "at": 32.63,
              "until": 36.26
            },
            {
              "text": "Your textbook still carries his work",
              "sub": "it was carried carefully, and improved",

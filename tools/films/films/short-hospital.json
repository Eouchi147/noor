            {
              "text": "A hospital that sent nobody a bill",
              "size": "hook",
              "at": 0.0,
              "until": 3.56
            },
            {
              "text": "Baghdad, Damascus, Cairo, from the 800s",
              "sub": "they called it the bimaristan",
              "size": "h1",
              "at": 3.9,
              "until": 9.91
            },
            {
              "text": "Wards for fevers, and for wounds",
              "sub": "and a ward for illnesses of the mind",
              "size": "h1",
              "at": 10.25,
              "until": 16.41
            },
            {
              "text": "A pharmacy on site, and a teaching round",
              "size": "h1",
              "at": 16.75,
              "until": 20.68
            },
            {
              "text": "Paid for by waqf, an endowment",
              "sub": "money set aside for ever",
              "size": "h1",
              "at": 21.02,
              "until": 26.1
            },
            {
              "text": "Rich and poor, any faith, any country",
              "size": "h1",
              "at": 26.44,
              "until": 30.12
            },
            {
              "text": "No one turned away, no bill at the door",
              "size": "h1",
              "at": 30.46,
              "until": 34.37
            },
            {
              "text": "Cairo gave music to the sleepless",

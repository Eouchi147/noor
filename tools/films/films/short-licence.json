          "hold": 50.1,
          "lines": [
            {
              "text": "One woman checked every copy by ear",
              "sub": "every copy read back, out loud, line by line",
              "size": "hook",
              "at": 0.0,
              "until": 6.99
            },
            {
              "text": "Makkah, in Arabia, about 1020",
              "sub": "the scholar Karima al-Marwaziyya",
              "size": "h1",
              "at": 7.33,
              "until": 12.77
            },
            {
              "text": "Karima holds the most trusted copy",
              "sub": "the most checked book after the Qur'an",
              "size": "h1",
              "at": 13.11,
              "until": 19.49
            },
            {
              "text": "Copying by hand lets errors creep in",
              "size": "h1",
              "at": 19.83,
              "until": 23.44
            },
            {
              "text": "So you read yours back to her",
              "sub": "out loud, checked line by line",
              "size": "h1",
              "at": 23.78,
              "until": 29.29
            },
            {
              "text": "One error caught is one error stopped",
              "size": "h1",
              "at": 29.63,
              "until": 33.31
            },
            {
              "text": "Only then does she sign your licence",
              "size": "h1",
              "at": 33.65,
              "until": 37.26
            },
            {
              "text": "Fifty years as the checkpoint",
              "sub": "the hadith you hear still pass through her",
              "size": "h1",
              "at": 37.6,
              "until": 43.91
            },
            {
              "eyebrow": "Karima al-Marwaziyya, Makkah",
              "text": "She died in Makkah, near a hundred",
              "src": "Sahih al-Bukhari, her checked copy, 1070",

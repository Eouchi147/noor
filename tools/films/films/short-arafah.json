          "lines": [
            {
              "text": "You arrive full, and you leave empty",
              "sub": "the same two cloths mark both ends",
              "size": "hook",
              "at": 0.0,
              "until": 6.29
            },
            {
              "text": "Arafah, the ninth of Dhul Hijjah, the peak",
              "size": "h1",
              "at": 6.63,
              "until": 10.69
            },
            {
              "text": "A man in ihram wears two unstitched sheets",
              "size": "h1",
              "at": 11.03,
              "until": 15.09
            },
            {
              "text": "At the line, every marker is taken off",
              "sub": "a citizen and a refugee, side by side",
              "size": "h1",
              "at": 15.43,
              "until": 22.16
            },
            {
              "text": "The same clothing on the Day of Standing",
              "size": "h1",
              "at": 22.5,
              "until": 26.43
            },
            {
              "text": "You return as the day your mother bore you",
              "sub": "the condition: no obscenity, no quarrel",
              "size": "h1",
              "at": 26.77,
              "until": 33.85
            },
            {
              "text": "The circle is drawn empty on purpose",
              "size": "h1",
              "at": 34.19,
              "until": 37.8
            },
            {
              "text": "A newborn has no history: that is the gift",
              "size": "h1",
              "at": 38.14,
              "until": 42.25
            },
            {
              "eyebrow": "The standing, at Arafah",
              "text": "The sign is what changed afterwards",
              "sub": "not what you felt while standing there",
              "src": "The heart of it",
              "size": "h1",
              "at": 42.59,
              "until": 50.83
            }

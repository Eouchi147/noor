          "lines": [
            {
              "text": "Hajj is Islam's fifth pillar, and a call",
              "size": "hook",
              "at": 0.0,
              "until": 3.93
            },
            {
              "text": "The House, once in a life, in Dhul Hijjah",
              "sub": "for whoever can find a way there",
              "size": "h1",
              "at": 4.27,
              "until": 10.86
            },
            {
              "text": "Ibrahim was told to make the call",
              "size": "h1",
              "at": 11.2,
              "until": 14.61
            },
            {
              "text": "One man called out in an empty valley",
              "sub": "every crowd since has been the echo",
              "size": "h1",
              "at": 14.95,
              "until": 21.43
            },
            {
              "text": "You answer labbayk: here I am",
              "size": "h1",
              "at": 21.77,
              "until": 24.86
            },
            {
              "text": "The verse says whoever is able, just once",
              "size": "h1",
              "at": 25.2,
              "until": 29.19
            },
            {
              "text": "Hanafis, Malikis excuse permanent illness",
              "sub": "Shafi'is, Hanbalis: he must send someone",
              "size": "h1",
              "at": 29.53,
              "until": 36.41
            },
            {
              "text": "The accepted Hajj's only reward: Paradise",
              "size": "h1",
              "at": 36.75,
              "until": 40.64
            },
            {
              "eyebrow": "Labbayk, at the House",
              "text": "One call still being answered today",
              "src": "The fifth pillar, and its verse",
              "size": "h1",
              "at": 40.98,
              "until": 46.14
            }

        {
          "kind": "title",
          "text": "Cairo, Egypt, 1020",
          "sub": "here, Ibn al-Haytham lights a candle",
          "hold": 5.341,
          "shot": "hold"
        },
        {
          "kind": "title",
          "text": "One small hole in the wall",
          "sub": "and light only travels straight",
          "hold": 4.4,
          "shot": "hold"
        },
        {
          "kind": "title",
          "text": "It lands on the wall opposite",
          "hold": 3.8,
          "shot": "hold"
        },
        {
          "kind": "title",
          "text": "Upside down",
          "sub": "the top crossed over at the hole",
          "hold": 4.6,
          "shot": "hold"
        },
        {
          "kind": "title",
          "text": "That is a camera",
          "hold": 3.8,
          "shot": "hold"
        },
        {
          "kind": "title",
          "text": "Then he broke an older idea",
          "sub": "eyes shoot rays out to see",
          "hold": 4.453,
          "shot": "hold"
        },
        {
          "kind": "title",
          "text": "No eye was in that room",
          "sub": "the picture formed anyway",
          "hold": 3.8,
          "shot": "hold"
        },
        {
          "kind": "title",
          "text": "Light comes in. The eye reads it",
          "hold": 4.0,
          "shot": "hold"
        },
        {
          "kind": "title",
          "text": "Camera obscura means dark room",
          "eyebrow": "Ibn al-Haytham, Cairo",
          "sub": "al-bayt al-muzlim, the dark house",
          "src": "The Book of Optics, about 1020",

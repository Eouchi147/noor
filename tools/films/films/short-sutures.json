          "lines": [
            {
              "text": "Your surgeon's tools were drawn in 1000",
              "sub": "drawn precisely enough for surgeons to copy",
              "size": "hook",
              "at": 0.0,
              "until": 7.09
            },
            {
              "text": "Cordoba, Spain, about the year 1000",
              "sub": "a surgeon named Abu al-Qasim al-Zahrawi",
              "size": "h1",
              "at": 7.43,
              "until": 13.89
            },
            {
              "text": "He draws each tool, precise enough to copy",
              "size": "h1",
              "at": 14.23,
              "until": 18.29
            },
            {
              "text": "Centuries later, the shapes sit on a tray",
              "size": "h1",
              "at": 18.63,
              "until": 22.62
            },
            {
              "text": "He stitches wounds with thread of catgut",
              "sub": "thread made from animal gut",
              "size": "h1",
              "at": 22.96,
              "until": 28.95
            },
            {
              "text": "The body slowly absorbs the thread itself",
              "size": "h1",
              "at": 29.29,
              "until": 33.23
            },
            {
              "text": "Old thread had to be cut back out",
              "sub": "his stitches leave with no second cut",
              "size": "h1",
              "at": 33.57,
              "until": 39.91
            },
            {
              "text": "Dissolving stitches work on his principle",
              "size": "h1",
              "at": 40.25,
              "until": 44.14
            },
            {
              "eyebrow": "Al-Zahrawi, Cordoba",
              "text": "He drew around two hundred instruments",

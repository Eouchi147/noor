          "lines": [
            {
              "text": "A school with no building at all",
              "size": "hook",
              "at": 0.0,
              "until": 3.56
            },
            {
              "text": "Sokoto, northern Nigeria, the 1830s",
              "sub": "a scholar, Nana Asma'u, builds it",
              "size": "h1",
              "at": 3.9,
              "until": 9.91
            },
            {
              "text": "The villages are full of unschooled women",
              "size": "h1",
              "at": 10.25,
              "until": 14.19
            },
            {
              "text": "So the teachers go to them",
              "size": "h1",
              "at": 14.53,
              "until": 17.42
            },
            {
              "text": "Trained women walk out to the villages",
              "sub": "carrying her lessons as poems",
              "size": "h1",
              "at": 17.76,
              "until": 23.75
            },
            {
              "text": "They memorize her poems in their tongue",
              "size": "h1",
              "at": 24.09,
              "until": 27.9
            },
            {
              "text": "Village women come in, study",
              "sub": "and walk home as teachers themselves",
              "size": "h1",
              "at": 28.24,
              "until": 33.98
            },
            {
              "text": "Her school outlasted the state itself",
              "sub": "and schools still carry her name",
              "size": "h1",
              "at": 34.32,
              "until": 40.45
            },
            {
              "eyebrow": "Nana Asma'u, Sokoto",
              "text": "jaji: her title for a trained teacher",
              "src": "She wrote over sixty works, died 1864",
              "size": "h1",
              "at": 40.79,
              "until": 45.95
            }

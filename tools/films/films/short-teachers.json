          "plate": "teachers",
          "hold": 44.0,
          "lines": [
            {
              "text": "A school with no building at all",
              "size": "hook",
              "at": 0.0,
              "until": 3.56
            },
            {
              "text": "Sokoto, northern Nigeria, the 1830s",
              "sub": "built by a scholar, Nana Asma'u",
              "size": "h1",
              "at": 3.9,
              "until": 9.78
            },
            {
              "text": "The countryside is full of women",
              "size": "h1",
              "at": 10.12,
              "until": 13.41
            },
            {
              "text": "So the teachers go to them",
              "size": "h1",
              "at": 13.75,
              "until": 16.64
            },
            {
              "text": "Trained women walk out to the villages",
              "sub": "carrying her lessons as poems",
              "size": "h1",
              "at": 16.98,
              "until": 22.97
            },
            {
              "text": "Learned by heart, in her language",
              "size": "h1",
              "at": 23.31,
              "until": 26.67
            },
            {
              "text": "Village women come in, study",
              "sub": "and walk home as teachers themselves",
              "size": "h1",
              "at": 27.01,
              "until": 32.75
            },
            {
              "text": "It ran for generations",
              "sub": "and outlasted the state that held it",
              "size": "h1",
              "at": 33.09,
              "until": 38.43
            },
            {
              "eyebrow": "Nana Asma'u, Sokoto",
              "text": "Its leaders are still called jaji",
              "src": "She wrote over sixty works, died 1864",
              "size": "h1",
              "at": 38.77,
              "until": 43.61
            }

          "lines": [
            {
              "text": "Your car's crankshaft is 800 years old",
              "size": "hook",
              "at": 0.0,
              "until": 3.74
            },
            {
              "text": "Diyarbakir, upper Mesopotamia, 1206",
              "sub": "An engineer, Al-Jazari, finishes his book",
              "size": "h1",
              "at": 4.08,
              "until": 10.57
            },
            {
              "text": "His book explains 50 machines in detail",
              "sub": "precise enough for someone to build",
              "size": "h1",
              "at": 10.91,
              "until": 17.42
            },
            {
              "text": "A turning wheel drives a straight rod",
              "sub": "rotation becomes a back and forth stroke",
              "size": "h1",
              "at": 17.76,
              "until": 24.52
            },
            {
              "text": "The rod drives a twin cylinder water pump",
              "size": "h1",
              "at": 24.86,
              "until": 28.85
            },
            {
              "text": "Pegs set in a turning barrel keep rhythm",
              "sub": "move the pegs, and the tune changes",
              "size": "h1",
              "at": 29.19,
              "until": 35.87
            },
            {
              "text": "A program you could touch, centuries early",
              "size": "h1",
              "at": 36.21,
              "until": 40.22
            },
            {
              "text": "Your engine still turns his crank and rod",
              "size": "h1",
              "at": 40.56,
              "until": 44.55
            },
            {
              "eyebrow": "Al-Jazari, Diyarbakir",
              "text": "He wrote and illustrated it himself",

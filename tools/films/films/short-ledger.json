          "lines": [
            {
              "text": "A ruler gave back what a family took",
              "sub": "the ruler's own family, starting at home",
              "size": "hook",
              "at": 0.0,
              "until": 6.74
            },
            {
              "text": "Damascus, Syria, in the year 717",
              "sub": "a new caliph, Umar ibn Abd al-Aziz",
              "size": "h1",
              "at": 7.08,
              "until": 13.06
            },
            {
              "text": "First he returns his own estates",
              "size": "h1",
              "at": 13.4,
              "until": 16.69
            },
            {
              "text": "Then his wife Fatima gives up her jewels",
              "size": "h1",
              "at": 17.03,
              "until": 20.96
            },
            {
              "text": "He refuses the royal stables outright",
              "sub": "a luxury every ruler before him kept",
              "size": "h1",
              "at": 21.3,
              "until": 27.74
            },
            {
              "text": "All of it flows to the public treasury",
              "size": "h1",
              "at": 28.08,
              "until": 31.87
            },
            {
              "text": "Before him, converts paid an outsider tax",
              "sub": "he ruled only thirty months in all",
              "size": "h1",
              "at": 32.21,
              "until": 38.84
            },
            {
              "text": "Power can still be used as repentance",
              "size": "h1",
              "at": 39.18,
              "until": 42.86
            },
            {
              "eyebrow": "Umar ibn Abd al-Aziz, Damascus",
              "text": "Ruled the empire, kept almost none of it",
